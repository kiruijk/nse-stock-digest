<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs daily-update.sh at 12:15 PM Mac time on weekdays (7:15 PM Nairobi while the Mac is
  on US Eastern daylight time, 8:15 PM in winter; the NSE closes at 3 PM Nairobi). If the Mac
  is asleep then, launchd runs it on wake.
  Install:   cp launchd/com.kiruijk.nse-stock-digest.plist ~/Library/LaunchAgents/
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kiruijk.nse-stock-digest.plist
  Run now:   launchctl kickstart gui/$(id -u)/com.kiruijk.nse-stock-digest
  Uninstall: launchctl bootout gui/$(id -u)/com.kiruijk.nse-stock-digest
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kiruijk.nse-stock-digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jameskirui/git/kiruijk/nse-stock-digest/daily-update.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/jameskirui/git/kiruijk/nse-stock-digest/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jameskirui/git/kiruijk/nse-stock-digest/logs/launchd.log</string>
</dict>
</plist>
